{
  "name": "services-back",
  "version": "1.0.0",
  "description": "express server to handel user services and the related admin dashboard",
  "license": "ISC",
  "author": "mohamed-amin",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && copyfiles -u 2 \"src/database/generated/**/*\" dist/database",
    "start": "NODE_PATH=dist node -r ./dist/alias.js dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate-dev": "prisma migrate dev --create-only",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:validate": "prisma validate",
    "db:introspect": "prisma db pull",
    "db:format": "prisma format",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "prepare": "husky"
  },
  "overrides": {
    "@hono/node-server": "~1.19.13",
    "@tootallnate/once": "~3.0.1"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.4.2",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.5.2",
    "socket.io": "^4.8.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@ngrok/ngrok": "^1.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.1",
    "copyfiles": "^2.4.1",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "prisma": "^7.4.0",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.2"
  }
}
