generator client {
  provider = "prisma-client-js"
  output   = "../src/database/generated"
}

datasource db {
  provider = "mysql"
}

enum AdministratorRole {
  SUPER_ADMIN
  ADMIN
}

model Administrator {
  id          String             @id @default(uuid()) @db.Char(36)
  fullName    String             @db.VarChar(128)
  email       String             @unique @db.VarChar(128)
  password    String             @db.VarChar(128)
  role        AdministratorRole  @default(ADMIN) @map("role")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt   DateTime?          @map("deleted_at") @db.Timestamp(6)

  @@map("administrators")
}

model Client {
  id                  String               @id @default(uuid()) @db.Char(36)
  phone               String               @unique @db.VarChar(128)
  password            String               @db.VarChar(128)
  fullName            String               @map("full_name") @db.VarChar(128)
  email               String               @unique @db.VarChar(128)
  firebaseToken       String?              @map("firebase_token") @db.VarChar(256)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamp(6)
  refreshTokens       RefreshToken[]

  @@map("clients")
}

model Otp {
  id        String   @id @default(uuid())
  phone     String
  otp       String
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("otps")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Char(36)
  tokenHash    String    @unique @map("token_hash") @db.VarChar(128)
  clientId     String?   @map("client_id") @db.Char(36)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamp(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamp(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  client     Client?     @relation(fields: [clientId], references: [id], onDelete: Cascade)


  @@index([clientId])
  @@map("refresh_tokens")
}



